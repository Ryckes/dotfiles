export EXTRA_FILE="$HOME/dotfiles/bash_extra"
export LOCAL_EXTRA="$HOME/dotfiles/local_extra.sh"
export LOCAL_EXTRA_BEFORE="$HOME/dotfiles/local_extra_before.sh"

[ -r "$LOCAL_EXTRA_BEFORE" ] && . $LOCAL_EXTRA_BEFORE

# Append to history after each command
PROMPT_COMMAND="history -a; history -c; history -r; $PROMPT_COMMAND"

alias ls="ls --color=auto"
alias la="ls -a"
alias ll="ls -l"

alias grep="grep --color"

alias s="git status"
alias a="git add"
alias c="git commit"
alias amend="git commit --amend --no-edit"
alias d="git diff"
alias l="git log"
alias xl="git log"
alias co="git checkout"

export dc="docker compose"
export up="docker compose up"
export upb="docker compose up --build"
export down="docker compose down"

copy() {
    if [[ ! -z "$@" ]]; then
        printf "$@" | xclip -selection clipboard
    else
        # Take STDIN
        xclip -selection clipboard
    fi
}

if [[ -f "$HOME/bin/ec" ]]; then
   export EDITOR="ec"
fi

alias rc=". $EXTRA_FILE"
alias rcedit="$EDITOR $LOCAL_EXTRA &"

export PATH="$PATH:$HOME/projects/go/bin:$HOME/bin"
export PS1="[\u@\w] $ "


DOWNLOADS_DIR=~/Downloads

# Puts in DL the last X (3 by default) files in DOWNLOADS_DIR
dl() {
    mapfile -t DL < <(find "$DOWNLOADS_DIR" -maxdepth 1 -type f ! -name '.*' -exec ls -t {} + | head -n "${1:-3}")
    printf '%s\n' "${DL[@]}"
}

dlold() {
    mapfile -t DL < <(find "$DOWNLOADS_DIR" -maxdepth 1 -type f ! -name '.*' -exec ls -tr {} + | head -n "${1:-10}")
    printf '%s\n' "${DL[@]}"
}

dltoday() {
    mapfile -t DL < <(find "$DOWNLOADS_DIR" -maxdepth 1 -type f ! -name '.*' -newermt "$(date +%F)" -exec ls -t {} +)
    printf '%s\n' "${DL[@]}"
}

lltoday() {
    find "$DOWNLOADS_DIR" -maxdepth 1 -type f ! -name '.*' -newermt "$(date +%F)" -exec ls -lt {} +
}


# ---- HISTORY ----
export HISTCONTROL=ignoredups:erasedups  # no duplicate entries
export HISTSIZE=100000                   # big big history
export HISTFILESIZE=100000               # big big history
shopt -s histappend                      # append to history, don't overwrite it
# Save and reload the history after each command finishes
export PROMPT_COMMAND="history -a; history -c; history -r; $PROMPT_COMMAND"


[ -r "$LOCAL_EXTRA" ] && . $LOCAL_EXTRA
